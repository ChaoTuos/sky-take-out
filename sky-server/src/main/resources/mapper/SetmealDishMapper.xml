<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.SetmealDishMapper">
    <insert id="insertBatch" parameterType="list">
        insert into setmeal_dish
        (setmeal_id,dish_id,name,price,copies)
        values
        <foreach collection="setmealDishes" item="sd" separator=",">
            (#{sd.setmealId},#{sd.dishId},#{sd.name},#{sd.price},#{sd.copies})
        </foreach>
    </insert>
    <delete id="deleteBySetmealIds">
        delete from setmeal_dish where setmeal_id in
        <foreach collection="ids" item="setmealId" separator="," close=")" open="(">
            #{setmealId}
        </foreach>
    </delete>
    <delete id="deleteBySetmealId">
        delete from setmeal_dish where setmeal_id = #{id}
    </delete>
    <select id="getSetmealIdsByDishIds" resultType="java.lang.Long">
        <!-- 【修改】原为 select *，resultType=Long 时只会映射第一列 id；改为 setmeal_id -->
        select setmeal_id from setmeal_dish where dish_id in
        <foreach collection="dishIds" item="dishId" separator="," close=")" open="(">
            #{dishId}
        </foreach>
    </select>
    <select id="getBySetmealId" resultType="com.sky.entity.SetmealDish">
        select * from setmeal_dish where setmeal_id = #{id}
    </select>
</mapper>
